#!/usr/bin/env python3
"""pulse-ctl — the small, boring core behind the Pulse bar widget.

Jobs, deliberately kept apart:

  tick     read the sensors once, decide which profile the machine should be
           in, write the state file, and drive the desktop there. The QML
           panel only ever reads the state file this writes, so nothing in
           the decision path depends on the shell being alive.
  apply    put a named profile on the desktop by hand.
  stop     put the desktop back exactly as it was before Pulse touched it.

Prose here is English on purpose: this file is also the log surface, and
Omarchy keeps diagnostics in English. Only the panel is translated.

Three things make it safe to leave running on a laptop:

* Hyprland reports back every option we touch, so the pre-Pulse desktop is
  captured once and restored exactly — including "this option was never set
  and is running on the Omarchy default".
* `stop`, and the unit's ExecStopPost, put that baseline back. There is no
  path where a crash leaves your desktop flat forever.
* A missing sensor is skipped, never guessed. A machine with no readable
  hwmon node simply runs the load and memory tickers.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omarchy-pulse"
STATE_FILE = STATE_DIR / "state.json"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "omarchy-pulse"
CONFIG_FILE = CONFIG_DIR / "config.json"
# The running daemon owns state.json; commands never write it behind its back.
# They drop a request here and the daemon performs it inside its own loop, so
# the two cannot overwrite each other.
RUN_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "omarchy-pulse"
REQUEST_FILE = RUN_DIR / "request.json"
SERVICE = "pulse.service"

# Lightest first. "free" is not a profile: it means Pulse is not driving, and
# it is deliberately *outside* this tuple so that comparing against it raises
# nowhere — every caller checks for it explicitly instead.
PROFILES = ("light", "medium", "full")

# Game Mode is a separate axis, not a fourth rung: it is never chosen by a
# sensor threshold and never ranked against the others. Keeping it out of
# PROFILES means the ladder comparison stays honest.
GAME = "game"

# What `applied` says when Pulse has handed the desktop back. Treated as "no
# profile set", which is why the next tick must not try to rank it.
FREE = "free"

# Every Hyprland option Pulse is allowed to move.
#
# `path` is the key path inside the Lua config table, because Hyprland 0.56
# parses its config as Lua: `hyprctl keyword` refuses to run against a
# non-legacy parser ("keyword can't work with non-legacy parsers. Use eval"),
# so every write goes through `hyprctl eval 'hl.config({...})'`. Reading
# still works through `getoption`.
HYPR_OPTIONS = {
    "blur": {"path": ("decoration", "blur", "enabled"), "kind": "bool"},
    "animations": {"path": ("animations", "enabled"), "kind": "bool"},
    "dim_inactive": {"path": ("decoration", "dim_inactive"), "kind": "bool"},
    "gaps_out": {"path": ("general", "gaps_out"), "kind": "css"},
    "rounding": {"path": ("decoration", "rounding"), "kind": "int"},
    "vrr": {"path": ("misc", "vrr"), "kind": "int"},
}

# The `getoption` name for each key, used for reading the baseline back.
HYPR_READ = {
    "blur": "decoration:blur:enabled",
    "animations": "animations:enabled",
    "dim_inactive": "decoration:dim_inactive",
    "gaps_out": "general:gaps_out",
    "rounding": "decoration:rounding",
    "vrr": "misc:vrr",
}

# What each profile does to each option. None means "restore the baseline".
#
# The two steps are deliberately different in kind, not just in degree:
# medium drops the expensive decoration (blur and inactive dimming are
# per-pixel effects on every frame) while leaving movement alone, so windows
# still animate and the desktop still feels like itself. Light removes motion
# and spacing too, which is the step you notice immediately and the reason it
# is reserved for actual pressure.
HYPR_LEVELS = {
    "full": dict.fromkeys(HYPR_OPTIONS),
    "medium": {
        "blur": False,
        "dim_inactive": False,
        "animations": None,
        "gaps_out": None,
        "rounding": None,
        "vrr": None,
    },
    "light": {
        "blur": False,
        "animations": False,
        "dim_inactive": False,
        "gaps_out": 4,
        "rounding": 0,
        "vrr": None,
    },
    # Game Mode is not a fourth rung on the same ladder. It answers a
    # different question — "a game owns the screen, stop competing with it" —
    # and the answers are things the thermal ladder deliberately never does:
    # tear frames rather than buffer them, and let the panel follow the
    # game's own refresh rate. VRR is 0 (off) / 1 (on) / 2 (fullscreen only);
    # 2 is the setting that helps a game without touching the desktop.
    "game": {
        "blur": False,
        "animations": False,
        "dim_inactive": False,
        "gaps_out": 0,
        "rounding": 0,
        "vrr": 2,
    },
}


# --------------------------------------------------------------------------
# plumbing
# --------------------------------------------------------------------------

def run(cmd: list[str], timeout: float = 3.0) -> tuple[int, str]:
    """Run a command, never raise, always return (code, stdout)."""
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return proc.returncode, proc.stdout
    except (OSError, subprocess.SubprocessError):
        return 127, ""


def read_json(path: Path, fallback):
    try:
        with path.open(encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return fallback


def write_json(path: Path, data) -> None:
    """Write atomically so a reader never sees half a file."""
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(path.suffix + ".tmp")
        with tmp.open("w", encoding="utf-8") as handle:
            json.dump(data, handle, ensure_ascii=False, indent=2)
        tmp.replace(path)
    except OSError as exc:
        print(f"pulse-ctl: cannot write {path}: {exc}", file=sys.stderr)


def emit(data) -> None:
    json.dump(data, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")


def deepen(base: dict, override: dict) -> dict:
    """Merge override into base without mutating either."""
    result = dict(base)
    for key, value in override.items():
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = deepen(result[key], value)
        else:
            result[key] = value
    return result


def log(message: str) -> None:
    """One line per state change. The tick loop is silent otherwise."""
    print(f"pulse: {message}", file=sys.stderr, flush=True)


# --------------------------------------------------------------------------
# configuration
# --------------------------------------------------------------------------

def load_config(plugin_dir: Path) -> dict:
    defaults = read_json(plugin_dir / "config" / "default.json", {})
    if not defaults:
        defaults = read_json(Path(__file__).resolve().parent.parent / "config" / "default.json", {})
    user = read_json(CONFIG_FILE, {})
    return deepen(defaults, user if isinstance(user, dict) else {})


def save_config_patch(patch: dict) -> dict:
    current = read_json(CONFIG_FILE, {})
    if not isinstance(current, dict):
        current = {}
    merged = deepen(current, patch)
    write_json(CONFIG_FILE, merged)
    return merged


# --------------------------------------------------------------------------
# sensors
# --------------------------------------------------------------------------

_ZONE = re.compile(r"^(cpu|package|tdie|tctl|k10temp|x86_pkg_temp)", re.IGNORECASE)


def find_cpu_temp_path() -> str | None:
    """Locate a plausible CPU temperature input.

    Walks /sys/class/hwmon instead of hardcoding hwmon0: that numbering is
    probe-order dependent and changes across kernels and reboots, which is
    exactly the kind of thing that silently breaks a thermal tweaker.
    """
    root = Path("/sys/class/hwmon")
    candidates: list[tuple[int, str]] = []
    try:
        entries = sorted(root.iterdir())
    except OSError:
        return None

    for entry in entries:
        try:
            name = (entry / "name").read_text(encoding="utf-8").strip()
        except OSError:
            continue
        if not re.search(r"k10temp|coretemp|zenpower|cpu", name, re.IGNORECASE):
            continue
        for label_file in sorted(entry.glob("temp*_label")):
            try:
                label = label_file.read_text(encoding="utf-8").strip()
            except OSError:
                continue
            input_file = label_file.with_name(label_file.name.replace("_label", "_input"))
            if input_file.exists():
                rank = 0 if _ZONE.match(label) else 1
                candidates.append((rank, str(input_file)))
        fallback = entry / "temp1_input"
        if fallback.exists():
            candidates.append((2, str(fallback)))

    if not candidates:
        return None
    candidates.sort(key=lambda item: item[0])
    return candidates[0][1]


@dataclass
class Reading:
    name: str
    value: float | None = None
    available: bool = False
    detail: str = ""


def read_temp(cfg: dict) -> Reading:
    path = cfg.get("thresholdPath") or find_cpu_temp_path()
    if not path:
        return Reading("thermal", detail="no hwmon node found")
    try:
        value = float(Path(path).read_text(encoding="utf-8").strip()) / 1000.0
    except (OSError, ValueError):
        return Reading("thermal", detail=f"unreadable: {path}")
    if value <= 0 or value > 150:
        return Reading("thermal", detail=f"implausible reading: {value:.1f}")
    return Reading("thermal", value=value, available=True, detail=path)


def read_load() -> Reading:
    try:
        load1 = os.getloadavg()[0]
    except OSError:
        return Reading("load", detail="no loadavg")
    cores = os.cpu_count() or 1
    # Normalised so one threshold set works on a 4-thread laptop and a
    # 32-thread desktop: 1.0 means one runnable thread per core.
    return Reading(
        "load",
        value=load1 / cores,
        available=True,
        detail=f"load1 {load1:.2f} across {cores} threads",
    )


def read_memory() -> Reading:
    try:
        text = Path("/proc/meminfo").read_text(encoding="utf-8")
    except OSError:
        return Reading("memory", detail="no /proc/meminfo")

    avail = total = 0
    for line in text.splitlines():
        if line.startswith("MemAvailable:"):
            avail = int(line.split()[1])
        elif line.startswith("MemTotal:"):
            total = int(line.split()[1])
    if not total:
        return Reading("memory", detail="unparsable meminfo")

    return Reading(
        "memory",
        value=avail / total * 100.0,
        available=True,
        detail=f"{avail // 1024}M of {total // 1024}M available",
    )


# --------------------------------------------------------------------------
# decision
# --------------------------------------------------------------------------

# Which direction of each ticker is bad. Thresholds are named after the
# profile they want, so there is no comparing a "light" number against a
# "medium" number and getting the comparison backwards.
DIRECTION = {
    "thermal": "above",   # hot is bad
    "load": "above",      # busy is bad
    "memory": "below",    # little free memory is bad
}


def demand(reading: Reading, cfg: dict) -> tuple[str | None, str]:
    """Which profile this single ticker wants, and why.

    Returns (None, "") when the ticker is comfortable.
    """
    if not reading.available or reading.value is None:
        return None, ""

    value = reading.value
    if reading.name == "thermal":
        shown = f"{value:.0f}°C"
    elif reading.name == "load":
        shown = f"load {value:.2f}/thread"
    else:
        shown = f"{value:.0f}% memory free"

    if DIRECTION[reading.name] == "above":
        light_at, medium_at = cfg.get("lightAbove"), cfg.get("mediumAbove")
        if light_at is not None and value >= float(light_at):
            return "light", shown
        if medium_at is not None and value >= float(medium_at):
            return "medium", shown
    else:
        light_at, medium_at = cfg.get("lightBelow"), cfg.get("mediumBelow")
        if light_at is not None and value <= float(light_at):
            return "light", shown
        if medium_at is not None and value <= float(medium_at):
            return "medium", shown

    return None, ""


def read_gamemode(config: dict) -> Reading:
    """Is a game running, according to the GameMode daemon?

    Reads the `ClientCount` property rather than calling `QueryStatus`.
    That distinction matters: QueryStatus registers the *calling* process as
    a game, so a monitor that used it would make itself the game it is
    watching for and Pulse would be in Game Mode permanently.

    Returns a Reading whose value is the number of registered game clients.
    """
    cfg = config.get("tickers", {}).get("gamemode", {})
    service = cfg.get("service", "com.feralinteractive.GameMode")
    code, out = run(
        ["busctl", "--user", "--json=short", "get-property",
         service, "/com/feralinteractive/GameMode",
         "com.feralinteractive.GameMode", "ClientCount"]
    )
    if code != 0 or not out.strip():
        return Reading("gamemode", detail="gamemode daemon not reachable")
    try:
        payload = json.loads(out)
        count = int(payload.get("data", 0))
    except (ValueError, TypeError, AttributeError):
        return Reading("gamemode", detail="unreadable ClientCount")
    return Reading(
        "gamemode",
        value=float(count),
        available=True,
        detail=f"{count} game client{'s' if count != 1 else ''} registered",
    )


def desired_profile(readings: list[Reading], config: dict) -> tuple[str, list[str]]:
    """Take the lightest profile any ticker asks for, with its reasons.

    Game Mode outranks every sensor. A machine that is hot *and* running a
    game should do what the game needs, not what the thermal ladder would
    have done on its own — and when the game exits, the ladder resumes from
    whatever the sensors say at that moment.
    """
    tickers = config.get("tickers", {})
    target = "full"
    reasons: list[str] = []

    for reading in readings:
        cfg = tickers.get(reading.name, {})
        if not cfg.get("enabled", True):
            continue

        if reading.name == "gamemode":
            if reading.available and reading.value and reading.value > 0:
                return GAME, [reading.detail]
            continue

        want, reason = demand(reading, cfg)
        if want is None:
            continue
        reasons.append(reason)
        if PROFILES.index(want) < PROFILES.index(target):
            target = want

    return target, reasons


# --------------------------------------------------------------------------
# Hyprland side
# --------------------------------------------------------------------------

def hypr_available() -> bool:
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return False
    code, _ = run(["hyprctl", "-j", "version"])
    return code == 0


def hypr_get(option: str) -> dict | None:
    code, out = run(["hyprctl", "-j", "getoption", option])
    if code != 0 or not out.strip():
        return None
    try:
        return json.loads(out)
    except ValueError:
        return None


def daemon_running() -> bool:
    """Is the loop actually alive to act on a request?"""
    code, out = run(["systemctl", "--user", "is-active", SERVICE])
    return code == 0 and out.strip() == "active"


def request(action: str, **payload) -> bool:
    """Ask the running daemon to do something, inside its own loop.

    The daemon rewrites state.json every tick. A command that wrote state
    alongside it would be overwritten within the poll interval — which is
    exactly the bug this replaces — so commands hand the work over instead.
    """
    RUN_DIR.mkdir(parents=True, exist_ok=True)
    write_json(REQUEST_FILE, {"action": action, "at": time.time(), **payload})
    return True


def take_request() -> dict | None:
    """Consume a pending request, if any. Called once per tick by the loop."""
    if not REQUEST_FILE.exists():
        return None
    data = read_json(REQUEST_FILE, None)
    try:
        REQUEST_FILE.unlink()
    except OSError:
        pass
    return data if isinstance(data, dict) else None


def handle_request(req: dict, config: dict, state: dict) -> None:
    """Carry out one request. Runs inside the daemon's own loop."""
    action = req.get("action")

    if action == "profile":
        value = req.get("value")
        if value not in PROFILES:
            return
        # Pinning also disables adaptation: a profile you asked for should not
        # be overruled two seconds later by a temperature reading.
        save_config_patch({"enabled": False, "profile": value})
        if state.get("baseline") is None:
            state["baseline"] = capture_baseline()
        state["lastChanged"] = apply_profile(value, state["baseline"])
        state["applied"] = value
        state["evaluated"] = value
        state["since"] = time.time()
        state["candidate"] = ""
        state["candidateTicks"] = 0
        log(f"pinned to {value}")

    elif action == "enable":
        on = bool(req.get("value"))
        save_config_patch({"enabled": on})
        # Turning adaptation back on is also how a released daemon picks the
        # desktop up again, so it clears the flag that kept it idle.
        if on:
            state["released"] = False
            if state.get("applied") == FREE:
                state["applied"] = "full"
        state["candidate"] = ""
        state["candidateTicks"] = 0
        state["since"] = time.time()
        log("adaptation on" if on else "adaptation off")

    elif action == "stop":
        baseline = state.get("baseline")
        if baseline:
            apply_baseline(baseline)
        state["applied"] = FREE
        state["released"] = True
        state["evaluated"] = "full"
        state["baseline"] = None
        log("released the desktop back to its baseline")


def capture_baseline() -> dict:
    """Snapshot every option we might touch, before touching any of it."""
    baseline: dict = {}
    for key, spec in HYPR_OPTIONS.items():
        data = hypr_get(HYPR_READ[key])
        kind = spec["kind"]
        if data is None:
            baseline[key] = {"kind": kind, "value": None}
            continue
        if kind == "bool":
            value = data.get("bool")
        elif kind == "css":
            # Reported as "10 10 10 10"; keep only the numbers we can write
            # back, and only if all four agree (a uniform gap is the only
            # shape Pulse sets anyway).
            numbers = {int(n) for n in str(data.get("css") or "").split() if n.lstrip("-").isdigit()}
            value = numbers.pop() if len(numbers) == 1 else None
        else:
            value = data.get("int")
        baseline[key] = {"kind": kind, "value": value}

    # The power profile is restored the same way the Hyprland options are, so
    # Game Mode does not leave the laptop in performance after the game quits.
    code, out = run(["powerprofilesctl", "get"])
    baseline["powerProfile"] = out.strip() if code == 0 and out.strip() else None
    return baseline


def lua_literal(value) -> str:
    """Render a Python value as a Lua literal.

    Only bools and ints are allowed through. Hyprland's css_gap type takes an
    integer (or a named table) and rejects the "10 10 10 10" spelling it
    itself prints, so there is no reason for a string to reach the evaluator
    and every reason for one not to.
    """
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    raise TypeError(f"unsupported value for Hyprland config: {value!r}")


def hypr_set(key: str, value) -> bool:
    """Write one option through Hyprland's Lua evaluator.

    Built from a fixed key path and a verified literal, never from free text.
    Scalars sit directly under their final key; only the keys themselves nest.
    """
    spec = HYPR_OPTIONS[key]
    node = lua_literal(value)
    for part in reversed(spec["path"]):
        node = "{ " + part + " = " + node + " }"
    code, out = run(["hyprctl", "eval", f"hl.config({node})"])
    if code != 0:
        return False
    # A rejected value comes back as "ok" with Hyprland logging the failure,
    # so confirm by reading it back rather than trusting the exit code.
    data = hypr_get(HYPR_READ[key])
    if data is None:
        return False
    if spec["kind"] == "bool":
        return bool(data.get("bool")) == bool(value)
    if spec["kind"] == "css":
        # gaps come back as "4 4 4 4": an int means uniform, so compare that.
        got = {int(n) for n in str(data.get("css") or "").split() if n.lstrip("-").isdigit()}
        return got == {int(value)}
    actual = data.get("int")
    return actual is not None and int(actual) == int(value)


def apply_baseline(baseline: dict) -> list[str]:
    restored: list[str] = []
    for key, spec in baseline.items():
        if key == "powerProfile":
            # Not a Hyprland option; it is a string and has its own writer.
            if spec and set_power_profile(str(spec)):
                restored.append("power-profile")
            continue
        value = spec.get("value")
        if value is not None and hypr_set(key, value):
            restored.append(key)
    return restored


def power_profiles() -> set[str]:
    """Which profiles this machine actually offers.

    On this laptop power-profiles-daemon sits on the placeholder driver and
    offers only balanced and power-saver — asking for "performance" fails, so
    Game Mode asks for what exists rather than for what the daemon is
    supposed to have.
    """
    code, out = run(["powerprofilesctl", "list"])
    if code != 0:
        return set()
    return {m.group(1) for m in re.finditer(r"^\s*\*?\s*([a-z-]+):", out, re.MULTILINE)}


def set_power_profile(name: str) -> bool:
    if name not in power_profiles():
        return False
    code, _ = run(["powerprofilesctl", "set", name])
    return code == 0


def apply_profile(profile: str, baseline: dict) -> list[str]:
    """Move Hyprland to `profile`. Returns the option names that changed."""
    changed: list[str] = []

    # The power profile is not a Hyprland option and not every machine has
    # every profile, so it is applied separately and only when it exists.
    if profile == GAME:
        if set_power_profile("performance"):
            changed.append("power-profile:performance")
    elif baseline.get("powerProfile"):
        if set_power_profile(str(baseline["powerProfile"])):
            changed.append("power-profile:restore")

    if not hypr_available():
        return changed

    for key, target in HYPR_LEVELS.get(profile, {}).items():
        if target is None:
            value = (baseline.get(key) or {}).get("value")
            if value is not None and hypr_set(key, value):
                changed.append(key)
        elif hypr_set(key, target):
            changed.append(key)
    return changed


# --------------------------------------------------------------------------
# state
# --------------------------------------------------------------------------

def default_state() -> dict:
    return {
        "evaluated": "full",   # what the sensors said last tick
        "applied": "full",     # what the desktop is actually set to
        "since": 0.0,
        "candidate": "",
        "candidateTicks": 0,
        "reasons": [],
        "tempHistory": [],
        "lastChanged": [],
        "baseline": None,
        # True only when a person asked Pulse to let go. A restart does not
        # set it, which is what keeps `systemctl restart` from silently
        # leaving the desktop unmanaged.
        "released": False,
        "error": "",
    }


def load_state() -> dict:
    state = default_state()
    stored = read_json(STATE_FILE, {})
    if isinstance(stored, dict):
        state.update(stored)
    return state


def save_state(state: dict) -> None:
    # Keep the history short: it is a sparkline, not a record.
    state["tempHistory"] = (state.get("tempHistory") or [])[-40:]
    write_json(STATE_FILE, state)


def snapshot(config: dict, state: dict) -> dict:
    """The JSON the panel reads. Shaped for display, not for decisions."""
    thermal = (state.get("sensors") or {}).get("thermal") or {}
    return {
        "profile": state.get("applied", "full"),
        "evaluated": state.get("evaluated", "full"),
        "configured": config.get("profile", "medium"),
        "enabled": bool(config.get("enabled", True)),
        "reasons": state.get("reasons") or [],
        "candidate": state.get("candidate") or "",
        "candidateTicks": state.get("candidateTicks", 0),
        "hysteresis": int(config.get("hysteresis", 3)),
        "since": state.get("since", 0),
        "temp": thermal.get("value"),
        "history": state.get("tempHistory") or [],
        "sensors": state.get("sensors") or {},
        "hyprland": hypr_available(),
        "lastChanged": state.get("lastChanged") or [],
        "error": state.get("error") or "",
        "updated": time.time(),
    }


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

def take_readings(config: dict) -> list[Reading]:
    tickers = config.get("tickers", {})
    readings: list[Reading] = []
    if tickers.get("thermal", {}).get("enabled", True):
        readings.append(read_temp(tickers.get("thermal", {})))
    if tickers.get("load", {}).get("enabled", True):
        readings.append(read_load())
    if tickers.get("memory", {}).get("enabled", True):
        readings.append(read_memory())
    if tickers.get("gamemode", {}).get("enabled", True):
        readings.append(read_gamemode(config))
    return readings


def evaluate(config: dict, state: dict, *, apply: bool) -> None:
    """One decision cycle. Drives the desktop when `apply` is set."""
    readings = take_readings(config)
    state["sensors"] = {
        r.name: {
            "available": r.available,
            "value": None if r.value is None else round(r.value, 2),
            "detail": r.detail,
        }
        for r in readings
    }

    thermal = next((r for r in readings if r.name == "thermal"), None)
    if thermal and thermal.available and thermal.value is not None:
        history = list(state.get("tempHistory") or [])
        history.append(round(thermal.value, 1))
        state["tempHistory"] = history

    enabled = bool(config.get("enabled", True))
    if enabled:
        target, reasons = desired_profile(readings, config)
    else:
        # Pinned: the profile in the config is the target, whatever the
        # sensors say. It still has to be *applied*, which is why this is a
        # target and not an early return.
        target, reasons = config.get("profile", "medium"), []

    state["evaluated"] = target

    hysteresis = max(1, int(config.get("hysteresis", 3)))
    hold = max(0, int(config.get("holdSeconds", 6)))
    now = time.time()
    applied = state.get("applied", "full")

    # "free" means Pulse already handed the desktop back. It is not rankable
    # against a real profile, so a released daemon must not re-enter the
    # comparison — it has nothing to do until someone pins a profile or turns
    # adaptation back on.
    #
    # The `released` flag is what distinguishes "a person asked for control
    # back" from "the service was restarted": a restart clears the flag in
    # `cleanup`, so only an explicit release keeps Pulse idle.
    if applied == FREE and not state.get("released"):
        state["applied"] = "full"
        applied = "full"
    if applied == FREE:
        state["reasons"] = reasons if enabled else []
        return

    if apply and target != applied:
        if target == state.get("candidate"):
            state["candidateTicks"] = int(state.get("candidateTicks", 0)) + 1
        else:
            state["candidate"] = target
            state["candidateTicks"] = 1

        # Entering or leaving Game Mode is a state change, not a threshold
        # crossing: it takes effect on the same tick, because waiting three
        # seconds after launch is three seconds of a game not being optimised.
        #
        # `lighter` is computed only when neither side is Game Mode, because
        # "game" is not on the ladder and ranking it raises.
        gamebound = GAME in (target, applied)
        lighter = False if gamebound else PROFILES.index(target) < PROFILES.index(applied)

        settled = state["candidateTicks"] >= hysteresis
        cooled = (now - float(state.get("since", 0))) >= hold

        if not enabled or gamebound or (settled and (lighter or cooled)):
            state["lastChanged"] = apply_profile(target, state.get("baseline") or {})
            state["applied"] = target
            state["since"] = now
            state["candidate"] = ""
            state["candidateTicks"] = 0
            log(f"{applied} -> {target} ({'; '.join(reasons) or 'settled'})")
    elif target == applied:
        state["candidate"] = ""
        state["candidateTicks"] = 0

    state["reasons"] = reasons if enabled else []


def cmd_tick(config: dict, state: dict) -> int:
    if state.get("baseline") is None and hypr_available():
        state["baseline"] = capture_baseline()
    evaluate(config, state, apply=True)
    save_state(state)
    write_json(STATE_FILE.with_name("snapshot.json"), snapshot(config, state))
    return 0


def cmd_loop(config: dict, state: dict) -> int:
    """The service entry point: take requests, tick, sleep, clean up.

    Requests are drained *before* the tick, and the config is re-read after
    one arrives, so a profile pinned a moment ago is the profile this tick
    applies — instead of being overruled by the tick that was already in
    flight.
    """
    interval = max(0.5, float(config.get("pollInterval", 2.0)))
    plugin_dir = Path(__file__).resolve().parent.parent
    log(f"running, every {interval:g}s")

    try:
        while True:
            req = take_request()
            if req is not None:
                config = load_config(plugin_dir)
                handle_request(req, config, state)
                save_state(state)

            config = load_config(plugin_dir)
            cmd_tick(config, state)
            time.sleep(interval)
    except KeyboardInterrupt:
        pass
    finally:
        # Whatever ended us — SIGTERM, an exception, a clean Ctrl-C — hand the
        # desktop back before exiting.
        baseline = state.get("baseline")
        if baseline:
            apply_baseline(baseline)
            state["applied"] = FREE
            state["baseline"] = None
            save_state(state)
            log("released the desktop back to its baseline")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="pulse-ctl", description="Pulse: adaptive performance profiles for Omarchy"
    )
    parser.add_argument(
        "--plugin-dir",
        default=str(Path(__file__).resolve().parent.parent),
        help="plugin root, used to find config/default.json",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("loop", help="run the adaptation loop in the foreground (the service runs this)")
    sub.add_parser("tick", help="evaluate once, drive the desktop, write state")
    sub.add_parser("status", help="print the current snapshot without changing anything")
    sub.add_parser("stop", help="release the desktop back to its pre-Pulse baseline and stay out of it")
    sub.add_parser("cleanup", help="restore the baseline without marking the desktop released")

    p_profile = sub.add_parser("profile", help="pin a profile by hand and stop adapting")
    p_profile.add_argument("value", choices=list(PROFILES))

    p_enable = sub.add_parser("enable", help="turn adaptation on or off")
    p_enable.add_argument("value", choices=["on", "off"])

    args = parser.parse_args()
    plugin_dir = Path(args.plugin_dir).expanduser()
    config = load_config(plugin_dir)
    state = load_state()

    if args.command == "loop":
        return cmd_loop(config, state)

    if args.command == "tick":
        return cmd_tick(config, state)

    if args.command == "status":
        stored = read_json(STATE_FILE.with_name("snapshot.json"), None)
        if stored is None:
            evaluate(config, state, apply=False)
            stored = snapshot(config, state)
        emit(stored)
        return 0

    if args.command == "profile":
        if daemon_running():
            request("profile", value=args.value)
            emit({"ok": True, "queued": True, "profile": args.value})
            return 0
        # No daemon to hand it to: do the work here, and persist it the same
        # way a request would have.
        save_config_patch({"enabled": False, "profile": args.value})
        state["baseline"] = state.get("baseline") or capture_baseline()
        state["lastChanged"] = apply_profile(args.value, state["baseline"])
        state["applied"] = args.value
        state["evaluated"] = args.value
        state["since"] = time.time()
        save_state(state)
        write_json(STATE_FILE.with_name("snapshot.json"), snapshot(load_config(plugin_dir), state))
        emit({"ok": True, "queued": False, "profile": args.value, "changed": state["lastChanged"]})
        return 0

    if args.command == "enable":
        on = args.value == "on"
        if daemon_running():
            request("enable", value=on)
            emit({"ok": True, "queued": True, "enabled": on})
            return 0
        save_config_patch({"enabled": on})
        write_json(STATE_FILE.with_name("snapshot.json"), snapshot(load_config(plugin_dir), state))
        emit({"ok": True, "queued": False, "enabled": on})
        return 0

    if args.command == "stop":
        # A person asked for control back. That outlives the daemon, so it is
        # recorded as `released` and only an explicit `enable on` clears it.
        if daemon_running():
            request("stop")
            emit({"ok": True, "queued": True})
            return 0
        baseline = state.get("baseline")
        restored = apply_baseline(baseline) if baseline else []
        state["applied"] = FREE
        state["released"] = True
        state["baseline"] = None
        save_state(state)
        write_json(STATE_FILE.with_name("snapshot.json"), snapshot(load_config(plugin_dir), state))
        emit({"ok": True, "queued": False, "restored": restored})
        return 0

    if args.command == "cleanup":
        # The unit's ExecStopPost. Put the desktop back, but leave no trace
        # that would make the next start believe someone released it: a
        # restart is not a decision, and treating it as one left Pulse idle
        # forever after any `systemctl restart`.
        baseline = state.get("baseline")
        if baseline:
            apply_baseline(baseline)
        state["baseline"] = None
        save_state(state)
        emit({"ok": True})
        return 0

    return 2


if __name__ == "__main__":
    sys.exit(main())